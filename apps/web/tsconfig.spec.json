{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.mts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
